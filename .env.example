# Copy this file to .env
#
# The app holds NO OpenAI credential. EXPO_PUBLIC_* values are inlined into the
# shipped JS bundle at build time, so anything secret placed here is readable by
# anyone with the app binary. All OpenAI calls are proxied through the backend,
# which holds the key server-side (see backend/.env.example).

# Backend origin. Leave blank in development and the app derives the host from
# the Metro dev server (LAN IP on device, 10.0.2.2 on Android emulator,
# localhost otherwise). Set it for any release build.
# Example: EXPO_PUBLIC_API_URL=https://atio-api.example.org
EXPO_PUBLIC_API_URL=

# Shared secret that gates the backend's /api routes. It must match
# API_CLIENT_TOKEN in backend/.env. Leave both blank and the backend serves
# /api to anyone who can reach the host (fine on a laptop, not on a public
# origin). Set one side only and every /api call returns 401.
# This is a build-time constant, not a per-user credential: it is inlined into
# the shipped bundle, so treat it as a gate against casual traffic rather than
# as authentication.
EXPO_PUBLIC_API_CLIENT_TOKEN=

# FAO JSON:API origin, used for innovation data on the web build. Leave blank
# and the app uses the dev proxy (npm run proxy) in development and the portal
# itself in a release build.
#
# The proxy is the development default because the portal serves the JSON:API
# to anyone but sends no CORS header, so a browser discards the response before
# the app sees it. curl and native builds are unaffected — neither has a page
# origin — so a device can be pointed straight at the portal here.
# Example: EXPO_PUBLIC_JSONAPI_URL=https://sti-portal.fao.org/jsonapi
EXPO_PUBLIC_JSONAPI_URL=

# Where the web build reads the catalogue from.
#   jsonapi   the FAO portal directly (the default, and the rollback route)
#   supabase  the snapshot the importer publishes (npm run import:supabase)
# Supabase is used only when this says so AND both values below are set.
# Changing it needs a fresh build; npm run build:web clears the bundler cache.
EXPO_PUBLIC_DATA_SOURCE=

# Supabase project URL and publishable key. Both are public by design: the key
# reaches only the read RPCs, and the catalogue tables are not exposed.
# Example: EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Importer only (never EXPO_PUBLIC_, never in a bundle): the Postgres
# connection string, Supabase dashboard → Connect → Session pooler. Keep it in
# .env.local, which is git-ignored.
SUPABASE_DB_URL=
