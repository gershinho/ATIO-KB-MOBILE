npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# desloppify local state
.desloppify/

# test baseline (raw jest json; SUMMARY.txt is committed)
.test-baseline/*.json
scorecard.png
