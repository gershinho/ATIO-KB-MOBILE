# Copy this file to .env and fill in your Gemini API key (Google AI Studio).
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: the Gemini model. Defaults to gemini-3.6-flash, the newest stable
# Flash that reliably runs with thinking off (see supabase/functions/_shared/ai/gemini.js).
GEMINI_MODEL=
PORT=3001

# Optional shared secret gating the /api routes. When set, every request must
# send `Authorization: Bearer <this value>` and the app must be built with a
# matching EXPO_PUBLIC_API_CLIENT_TOKEN (see ../.env.example). When unset, the
# server logs a warning and leaves /api open to anyone who can reach it.
API_CLIENT_TOKEN=
